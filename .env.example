# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and insert your real API keys before running the pipeline.
# ==============================================================================

# Google Gemini API Key (used by nlp_engine.py and main.py)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional secondary Gemini keys for automatic round-robin / quota rotation
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Groq API Key (used by pipeline.py for Llama 3.3 70B extraction)
# Get a key from: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
