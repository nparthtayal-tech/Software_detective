# ==============================================================================
# Git Ignore for Forensic Investigation Intelligence Pipeline
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDEs & Editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Build, Packaging & Distribution ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Linting & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Logs, Dumps & Temp Files ---
*.log
*.tmp
*.bak
*.swp
*.pid

# --- Investigation Run Outputs ---
# Ignore large generated JSON case results, but track HTML reports and .gitkeep
output/*.json
output/*.log
output/*.tmp
!output/*.html
!output/.gitkeep

